{
  "rewrites": [
    {
      "source": "/((?!sitemap.xml|robots.txt|llms.txt|favicon.svg|og-image.png|pwa-192.png|pwa-512.png|api/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|slurp|checker|audit|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|Discordbot|TelegramBot|Googlebot|bingbot|Applebot|SemrushBot|AhrefsBot|MJ12bot|DotBot|Screaming Frog|Sogou|Baiduspider|YandexBot|DuckDuckBot|Pinterest|PageSpeed|Lighthouse|GTmetrix|Pingdom|WebPageTest|HeadlessChrome).*"
        }
      ],
      "destination": "/api/og-meta?path=/$1"
    },
    {
      "source": "/((?!sitemap.xml|robots.txt|llms.txt|favicon.svg|og-image.png|pwa-192.png|pwa-512.png|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
