{
  "rewrites": [
    {
      "source": "/((?!sitemap.xml|robots.txt|llms.txt|favicon.svg|og-image.png|pwa-192.png|pwa-512.png|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
